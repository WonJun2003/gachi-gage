# 사용할 LLM: auto | gemini | groq | mock
#  auto  = GEMINI_API_KEY가 있으면 gemini, 없고 GROQ_API_KEY가 있으면 groq, 둘 다 없으면 mock(데모 모드)
LLM_PROVIDER=auto

# Google Gemini (무료 티어) - https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI 이미지 그리기/보정용 (무료 키에서는 막혀 있을 수 있음 - 그래도 자동 보정·홍보 카드는 무료로 동작)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Groq (무료 티어, 대안) - https://console.groq.com/keys 에서 발급
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI 호출이 실패하면 데모용 규칙 기반 결과로 대신 보여줄지 (시연 중 끊김 방지)
FALLBACK_TO_MOCK=true

PORT=3000
